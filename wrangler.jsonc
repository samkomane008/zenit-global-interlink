// Cloudflare Workers static site. GitHub Actions runs the Vite build into dist, then deploys it.
{
  "name": "zenit-global-interlink",
  "compatibility_date": "2026-10-19",
  "routes": [
    { "pattern": "zenitglobal.co.za", "custom_domain": true },
    { "pattern": "www.zenitglobal.co.za", "custom_domain": true }
  ],
  "assets": {
    "directory": "dist",
    "not_found_handling": "404-page"
  }
}
